# Rising Tide - unit entities. GENERATED by build_unit_model.py: edit its template, not this file.
# A sub-unit's `sprite = X` (common/units/mltd_units.txt) resolves to the entity X_entity, as OWB's
# `sprite = mirelurk_infantry` does to mirelurk_infantry_entity (gfx/models/owbentity/jango_owb_base_entity.asset).
# The states are those of OWB's mirelurk_entity (less attack_fire, which it reaches only through next_state), in
# its and vanilla's idiom: idles and attacks are `looping = no` variants drawn by `chance`, an attack handing
# back to the attack state. Every clip ends where it starts, and the variants of one state (idle / idle2,
# attack / attack2) start in the sculpt's own pose, so they chain without a jump; the rest blend in and out.
# No `death` state: the mirelurk has none either.
# scale: the mesh is 8 units tall; an OWB human stands 7.37 x 0.8, a deathclaw 6.3 x 1.2.
entity = {
	name = "mltd_star_spawn_entity"
	pdxmesh = "mltd_star_spawn_mesh"
	scale = 1
	default_state = "idle"

	state = { name = "idle"	animation = "idle"	animation_blend_time = 0.4 animation_speed = 1.0 chance = 4 looping = no }
	state = { name = "idle"	animation = "idle2"	animation_blend_time = 0.4 animation_speed = 1.0 chance = 1 looping = no }
	state = { name = "move"	animation = "move"	animation_blend_time = 0.4 animation_speed = 1.0 }
	state = { name = "retreat"	animation = "move"	animation_blend_time = 0.4 animation_speed = 1.25 }
	state = { name = "attack"	animation = "attack"	animation_blend_time = 0.3 animation_speed = 1.0 chance = 3 looping = no next_state = "attack" }
	state = { name = "attack"	animation = "attack2"	animation_blend_time = 0.3 animation_speed = 1.0 chance = 2 looping = no next_state = "attack" }
	state = { name = "defend"	animation = "defend"	animation_blend_time = 0.3 animation_speed = 1.0 }
	state = { name = "support_attack"	animation = "attack2"	animation_blend_time = 0.3 animation_speed = 1.0 }
	state = { name = "training"	animation = "idle2"	animation_blend_time = 0.3 animation_speed = 1.0 }
}

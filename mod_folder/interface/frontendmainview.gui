guiTypes = {

	containerWindowType = {
		name ="frontend_background"
		position = { x=0 y =0 }
		size = {
			width = 1920
			height = 1440
			min = { width = 100% height = 100% }
			max = { width = 100% height = 10000 }
			preserve_aspect_ratio = yes
		}
		Orientation = center
		Origo = center
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite ="GFX_frontend_bg"
			alwaystransparent = yes
		}

		# Overlay construction created by Yard1 for OWB's snow; OWB ships it
		# commented out.  Rising Tide re-enables it with its own rain sprite,
		# declared in interface/mltd.gfx.  Together with the logo sprite below,
		# this is the only reason the file is overridden at all: delete our copy
		# and the background and the logo still show, but the rain stops moving
		# and the logo stops breathing.
		iconType = {
			name = "mltd_rain_anim"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_frontend_bg_mltd_rain"
			orientation = upper_left
		}
	}

	### MAIN MENU PANEL (upperleft)
	containerWindowType = {
		name ="mainmenu_panel_upperleft"
		position = { x = 0 y = -320 }
		show_position = { x = 0 y = -1 }
		animation_type = decelerated
		animation_time = 1000
		size = { width = 448 height = 300 }
		Orientation = CENTER_UP

		iconType = {
			name ="frontend_game_logo"
			# Rising Tide: the animated marquee, declared in interface/mltd.gfx.
			# The static sprite still resolves to our own texture, since
			# gfx/interface/logo_game_static.dds is overridden by path.
			spriteType = "GFX_frontend_game_logo_mltd_animated"
			#spriteType = "GFX_frontend_game_logo_static"
			position = { x = -230 y = 25 }
			# position = { x = -224 y = -420 }
		}
	}

	containerWindowType = {
		name = "owned_dlc_item"
		size = { width = 50 height = 50 }

